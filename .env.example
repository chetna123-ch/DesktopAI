# ========================
# API Keys (Required)
# ========================

# Groq API Key — required for Whisper transcription and LLM inference
# Get yours at: https://console.groq.com
GROQ_API_KEY=""

# Porcupine Access Key — required for wake word detection
# Get yours at: https://picovoice.ai (free tier available)
PORCUPINE_ACCESS_KEY=""

# ========================
# API Keys (Optional)
# ========================

# Alternative LLM providers (only needed if you switch from Groq)
TOGETHER_API_KEY=""
GOOGLE_API_KEY=""

# Tavily API Key — enables the web search tool
# Get yours at: https://tavily.com
TAVILY_API_KEY=""

# ========================
# Logging
# ========================

LOG_LEVEL=DEBUG

# ========================
# LangSmith Tracing (Optional)
# ========================

# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
# LANGSMITH_API_KEY=""
# LANGSMITH_PROJECT=""

# ========================
# Personalization
# ========================

# Customize the assistant's identity and your profile
ASSISTANT_NAME="Jasper"
OWNER_NAME="Your Name"
OWNER_AGE=""
OWNER_LOCATION=""
OWNER_OCCUPATION=""
OWNER_COLLEGE=""
OWNER_INTERESTS=""

# ========================
# Python Path
# ========================

PYTHONPATH=.

# ========================
# Mobile Device (Optional)
# For connecting to Android devices via ADB
# ========================

# MOBILE_HOST=""
# MOBILE_PORT=5555
# ADB_HOST="127.0.0.1"
# ADB_PORT=5037

# Command Execution Safety Settings
COMMAND_SAFETY_CHECK_ENABLED=true
COMMAND_TIMEOUT=30
COMMAND_MAX_OUTPUT_CHARS=2000